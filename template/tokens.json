{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg": {
      "base": { "$type": "color", "$value": "#0b0d14" },
      "deep": { "$type": "color", "$value": "#090b10" }
    },
    "grid": { "$type": "color", "$value": "rgba(255, 255, 255, 0.035)" },
    "surface": {
      "default": { "$type": "color", "$value": "rgba(17, 21, 32, 0.78)" },
      "solid": { "$type": "color", "$value": "#111520" },
      "2": { "$type": "color", "$value": "#161c29" },
      "deep": { "$type": "color", "$value": "#0c0f1a" },
      "card": { "$type": "color", "$value": "#121726" },
      "raised": { "$type": "color", "$value": "rgba(22, 28, 41, 0.9)" }
    },
    "border": {
      "default": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)" },
      "strong": { "$type": "color", "$value": "rgba(255, 255, 255, 0.16)" },
      "hairline": { "$type": "color", "$value": "rgba(255, 255, 255, 0.06)" }
    },
    "text": {
      "default": { "$type": "color", "$value": "#f8fafc" },
      "muted": { "$type": "color", "$value": "#9aa7b8" },
      "dim": { "$type": "color", "$value": "#94a3b8" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#34d399" },
      "strong": { "$type": "color", "$value": "#10b981" },
      "soft": { "$type": "color", "$value": "rgba(16, 185, 129, 0.15)" }
    },
    "indigo": { "$type": "color", "$value": "#a5b4fc" },
    "amber": { "$type": "color", "$value": "#fbbf24" },
    "danger": { "$type": "color", "$value": "#fb7185" },
    "violet": { "$type": "color", "$value": "#a855f7" },
    "cyan": { "$type": "color", "$value": "#38bdf8" },
    "rose": { "strong": { "$type": "color", "$value": "#f43f5e" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "10px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.35)", "offsetX": "0px", "offsetY": "6px", "blur": "18px", "spread": "0px" } },
    "2": { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.45)", "offsetX": "0px", "offsetY": "18px", "blur": "48px", "spread": "0px" } }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "dur": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "default": { "$type": "duration", "$value": "220ms" },
      "flip": { "$type": "duration", "$value": "560ms" },
      "spin": { "$type": "duration", "$value": "3.2s" },
      "urgent": { "$type": "duration", "$value": "450ms" }
    }
  },
  "layout": {
    "wideMax": { "$type": "dimension", "$value": "1240px" },
    "consoleMax": { "$type": "dimension", "$value": "1360px" }
  },
  "typography": {
    "fontFamily": { "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] } },
    "fontSize": { "base": { "$type": "dimension", "$value": "14px" } },
    "lineHeight": { "base": { "$type": "number", "$value": 1.4 } }
  }
}
